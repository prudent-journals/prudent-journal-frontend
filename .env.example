# Prudent Journals, frontend configuration.
# These NEXT_PUBLIC_ values are inlined into the browser bundle at build time.
# In Docker they are passed as build args (see docker-compose.yml).

# Base URL of the backend API, must end in /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Site identity, used for metadata, sitemap and OpenGraph
NEXT_PUBLIC_SITE_NAME=Prudent Journals
NEXT_PUBLIC_SITE_URL=http://localhost:3000
